@startuml usecase_current
left to right direction
actor "Khán giả" as U
actor ADMIN as A
actor SCANNER as S
actor "Quản trị viên gốc\nADMIN + email cấu hình" as R
actor SePay as P
rectangle "SLNA Ticketing" {
 usecase "Đăng nhập LOCAL/OAuth\nĐặt lại mật khẩu SMTP" as Auth
 usecase "Xác minh CCCD\nGiữ ghế 10 phút" as Hold
 usecase "Tạo đơn SePay\nHạn mới 15 phút" as Order
 usecase "Xác minh webhook\nPhát hành QR" as Pay
 usecase "Xem vé của mình" as View
 usecase "Soát QR đúng trận" as Scan
 usecase "Quản trị trận/nội dung\nVé giấy/đối soát" as Admin
 usecase "Cấp quyền ADMIN/SCANNER" as Role
 usecase "Chatbot Gemini\nDữ liệu và nguồn chính thức" as Chat
}
U --> Auth
U --> Hold
U --> Order
U --> View
U --> Chat
P --> Pay
A --> Admin
A --> Scan
S --> Scan
R --> Role
@enduml

@startuml payment_current
start
:CCCD VERIFIED, trận ON_SALE;
:Giữ 1–4 ghế HELD trong 10 phút;
:Tạo đơn PENDING hạn mới 15 phút;
:Vé SOLD, QR NULL;
:Chuyển khoản VietQR;
if (Webhook hợp lệ và khớp?) then (Có)
 :SUCCESS + QR + MATCHED;
else (Không)
 :REVIEW_* hoặc từ chối chữ ký;
 :Không phát hành vé;
endif
stop
@enduml

@startuml core_erd
entity users {
 * id : PK
 email : UNIQUE
 role
 token_version
}
entity matches {
 * id : PK
 status
}
entity orders {
 * id : PK
 user_id : FK
 status
 expires_at
}
entity tickets {
 * id : PK
 match_id : FK
 order_id : FK
 held_by : FK
 status
 ticket_qr_code : UNIQUE
 is_scanned
}
users ||--o{ orders
matches ||--o{ tickets
orders |o--o{ tickets
users |o--o{ tickets : held_by
note bottom of tickets
SOLD chưa đồng nghĩa đã thanh toán.
Không có bảng order_items.
end note
@enduml
