PORT=5000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
NODE_ENV=development
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

DB_HOST=localhost
DB_PORT=5432
DB_NAME=slna_ticketing
DB_USER=postgres
DB_PASSWORD=replace-me

BANK_ID=vietcombank
BANK_ACCOUNT_NO=replace-me
BANK_ACCOUNT_NAME=SLNA TICKETING

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Đồng bộ tin chính thức SLNAFC/VPF. Đặt 0 để tắt trên một instance cụ thể.
OFFICIAL_NEWS_SYNC_ENABLED=1
OFFICIAL_NEWS_SYNC_INTERVAL_MINUTES=30
OFFICIAL_NEWS_MAX_ARTICLES=8

# Trợ lý hội thoại AI. Không đưa khóa này vào frontend hoặc commit lên Git.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_MS=20000

# OAuth callback URLs to register with providers:
# http://localhost:5000/api/auth/oauth/google/callback
# http://localhost:5000/api/auth/oauth/facebook/callback

# Chỉ dùng khi frontend/backend thực sự nằm ở hai site HTTPS khác nhau.
# COOKIE_SAME_SITE=none
